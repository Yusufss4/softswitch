# Generates a C++ source that embeds static web assets (run with cmake -P).
#   -DOUTPUT=<file.cpp> -DASSET_DIR=<dir> -DASSETS="index.html;app.js;style.css"
set(_body "")
set(_table "")
set(_i 0)
foreach(_name IN LISTS ASSETS)
  file(READ "${ASSET_DIR}/${_name}" _hex HEX)
  string(LENGTH "${_hex}" _len)
  math(EXPR _bytes "${_len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _array "${_hex}")
  if(_name MATCHES "\\.html$")
    set(_type "text/html; charset=utf-8")
  elseif(_name MATCHES "\\.js$")
    set(_type "text/javascript; charset=utf-8")
  elseif(_name MATCHES "\\.css$")
    set(_type "text/css; charset=utf-8")
  elseif(_name MATCHES "\\.svg$")
    set(_type "image/svg+xml")
  else()
    set(_type "application/octet-stream")
  endif()
  string(APPEND _body "constexpr std::array<std::uint8_t, ${_bytes}> kAsset${_i}{${_array}};\n")
  string(APPEND _table "    Asset{\"/${_name}\", \"${_type}\", std::span<const std::uint8_t>(kAsset${_i})},\n")
  math(EXPR _i "${_i} + 1")
endforeach()
file(WRITE "${OUTPUT}.tmp" "// Generated by cmake/EmbedAssets.cmake -- do not edit.
#include \"softswitch/gui/assets.hpp\"

#include <array>

namespace softswitch::gui {
namespace {
${_body}
constexpr std::array kAssets{
${_table}};
}  // namespace

const Asset* find_asset(std::string_view path) noexcept {
  const std::string_view key = path == \"/\" ? std::string_view(\"/index.html\") : path;
  for (const Asset& a : kAssets) {
    if (a.path == key) {
      return &a;
    }
  }
  return nullptr;
}

}  // namespace softswitch::gui
")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
